# Single key (backward compatible)
GEMINI_API_KEY=your_gemini_api_key_here

# Preferred multi-key rotation:
# GEMINI_API_KEYS accepts comma, whitespace, or newline separated keys.
# GEMINI_API_KEYS=api_key_1,api_key_2,api_key_3

# Numbered keys are also supported and are useful when you have a large key pool.
GEMINI_API_KEY_1=your_first_gemini_api_key_here
GEMINI_API_KEY_2=your_second_gemini_api_key_here
# GEMINI_API_KEY_3=your_third_gemini_api_key_here
# GEMINI_API_KEY_4=your_fourth_gemini_api_key_here

# Alias also supported:
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_API_KEYS=api_key_1,api_key_2
# GOOGLE_API_KEY_1=api_key_1
# GOOGLE_API_KEY_2=api_key_2

GEMINI_MODEL=gemini-2.5-flash-lite
# Optional: comma-separated fallback models that the app can try before moving to the next key.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-flash-lite-latest,gemini-3-flash-preview

# Optional: extra rotation passes for transient 429/5xx failures.
GEMINI_ROTATION_RETRY_ROUNDS=2
GEMINI_ROTATION_RETRY_BACKOFF_SECONDS=0.35
